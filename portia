#!/bin/bash
# Portia — dev runner (start / stop / restart)
# Usage: ./portia [start|stop|restart]

DIR="$(cd "$(dirname "$0")" && pwd)"
NAME="portia"

stop_portia() {
  pkill -f "electron-vite dev" 2>/dev/null
  pkill -f "electron.*portia" 2>/dev/null
  pkill -f "Electron.*portia" 2>/dev/null
  sleep 0.3
  echo "⏹  Portia stopped"
}

start_portia() {
  # Kill any leftover instances first
  stop_portia 2>/dev/null
  echo "▶  Starting Portia dev..."
  cd "$DIR" && npm run dev &
  echo "   PID: $!"
}

case "${1:-start}" in
  start)   start_portia ;;
  stop)    stop_portia ;;
  restart) stop_portia; start_portia ;;
  *)       echo "Usage: portia [start|stop|restart]"; exit 1 ;;
esac
