{
  "name": "@pinecall/zenitel-client",
  "version": "0.1.0",
  "description": "HTTP client + network scanner for Zenitel intercom systems",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./scanner": {
      "import": { "types": "./dist/scanner.d.ts", "default": "./dist/scanner.js" },
      "require": { "types": "./dist/scanner.d.ts", "default": "./dist/scanner.js" }
    }
  },
  "bin": {
    "zenitel": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.21.0",
    "@types/node": "^22.0.0"
  },
  "files": ["dist"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/pinecall/portia",
    "directory": "packages/zenitel-client"
  }
}
