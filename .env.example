# ═══════════════════════════════════════════════
# Portia — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# All variables are optional — the app will prompt
# for missing values through the setup wizard.

# ── Pinecall ──────────────────────────────────
# Get your API key from https://pinecall.io
PORTIA_API_KEY=

# ── Twilio SIP ────────────────────────────────
# SIP domain from your Twilio Elastic SIP Trunk
PORTIA_SIP_DOMAIN=
PORTIA_SIP_NAME=
PORTIA_SIP_ID=
PORTIA_SIP_AUTH_USER=
PORTIA_SIP_AUTH_PASS=

# ── Voice & LLM ──────────────────────────────
# Voice format: provider:voice_id (e.g. elevenlabs:abc123)
PORTIA_VOICE_ID=
PORTIA_LLM_MODEL=gpt-4.1-mini

# ── Zenitel Intercom ──────────────────────────
# Default credentials for the Zenitel device
PORTIA_ZENITEL_USER=admin
PORTIA_ZENITEL_PASS=

# ── Advanced ──────────────────────────────────
# Relay timer for door open (milliseconds)
PORTIA_RELAY_TIMER_MS=7000

# Log level: debug, info, warn, error
PORTIA_LOG_LEVEL=info

# Optional test phone number (bypasses wizard)
PORTIA_TEST_PHONE=
